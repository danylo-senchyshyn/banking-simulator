# Copy this file to .env and fill in the values
# cp .env.example .env

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret-minimum-32-characters

# ─── PostgreSQL — Auth Service ────────────────────────────────────────────────
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

# ─── PostgreSQL — Account Service ────────────────────────────────────────────
ACCOUNT_DB_HOST=localhost
ACCOUNT_DB_PORT=5433
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASSWORD=account_pass

# ─── PostgreSQL — Transaction Service ────────────────────────────────────────
TRANSACTION_DB_HOST=localhost
TRANSACTION_DB_PORT=5434
TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DB_USER=transaction_user
TRANSACTION_DB_PASSWORD=transaction_pass

# ─── PostgreSQL — Fraud Service ───────────────────────────────────────────────
FRAUD_DB_HOST=localhost
FRAUD_DB_PORT=5435
FRAUD_DB_NAME=fraud_db
FRAUD_DB_USER=fraud_user
FRAUD_DB_PASSWORD=fraud_pass

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
